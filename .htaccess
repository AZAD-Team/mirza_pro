<Files "*.txt">
    Require all denied
</Files>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.log">
    Require all denied
</Files>
<Files "log.txt">
    Require all denied
</Files>
<Files "ss">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<FilesMatch "^config\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
